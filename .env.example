# PostgreSQL
# Local (docker compose):
DATABASE_URL=postgresql://tend:tend@localhost:5432/tend
# Neon production (Vercel) — use pooled URL for the app:
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon migrations (Vercel build + optional local) — direct/unpooled URL:
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-32-byte-or-longer-secret

# App
NODE_ENV=development
PORT=3000

# Production canonical host — used to redirect *.vercel.app traffic (optional override)
# CANONICAL_APP_HOST=app.tend.qzz.io
# MARKETING_HOST=tend.qzz.io

# Pre-alpha invite list — comma-separated emails allowed to register and sign in.
# Leave unset locally to allow any email. Set in production to close the app to invitees only.
# ALLOWED_EMAILS=you@example.com,friend@example.com

# Sentry — optional; leave unset locally to disable error reporting
# Web app (server + browser):
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Mobile app (Expo):
# EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Source map uploads (CI / production builds only):
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=your-sentry-auth-token
